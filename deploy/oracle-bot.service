[Unit]
Description=Oracle Quote Notification Bot
After=network.target ollama.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/oracle_chat
EnvironmentFile=/home/ubuntu/oracle_chat/.env
ExecStart=/home/ubuntu/oracle_chat/venv/bin/python /home/ubuntu/oracle_chat/scripts/run_bot.py
Restart=always
RestartSec=60

[Install]
WantedBy=multi-user.target
