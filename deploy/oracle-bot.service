[Unit]
Description=Oracle Telegram Bot
After=network.target ollama.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/oracle_chat
EnvironmentFile=/home/ubuntu/oracle_chat/.env
ExecStart=/home/ubuntu/oracle_chat/venv/bin/python /home/ubuntu/oracle_chat/bot/main.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
