[Unit]
Description=Oracle Quote Notification Worker (Local Ollama)
After=network.target ollama.service
Wants=ollama.service
[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/oracle_chat
EnvironmentFile=/home/ubuntu/oracle_chat/.env
ExecStart=/home/ubuntu/oracle_chat/venv/bin/python /home/ubuntu/oracle_chat/scripts/quote_bot.py
Restart=always
RestartSec=30
[Install]
WantedBy=multi-user.target
