[Unit]
Description=Oracle Modular API Pipeline Worker (Local Ollama)
After=network.target ollama.service
Wants=ollama.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/oracle_chat
EnvironmentFile=/home/ubuntu/oracle_chat/.env
ExecStart=/home/ubuntu/oracle_chat/venv/bin/python -m pipeline.runner /home/ubuntu/oracle_chat/configs/quote_pipeline.json
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
