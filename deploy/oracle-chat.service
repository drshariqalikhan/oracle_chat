[Unit]
Description=ORACLE CHAT FastAPI Service
After=network.target ollama.service
Wants=ollama.service

[Service]
Type=simple
User=__APP_USER__
Group=__APP_USER__
WorkingDirectory=__APP_DIR__
EnvironmentFile=__APP_DIR__/.env
ExecStart=__APP_DIR__/venv/bin/uvicorn backend.main:app --host 0.0.0.0 --port __APP_PORT__
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
